# Host-side rule: give the rplidar a fixed /dev/rplidar at mode 0666.
# Installed by create_udev_rules.sh. The container has its own copy with a
# hotplug hook: isaac_ros_common/docker/udev_rules/98-rplidar.rules.

ACTION=="add", SUBSYSTEMS=="usb", KERNEL=="ttyUSB*", \
  ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
  MODE:="0666", GROUP:="plugdev", \
  SYMLINK+="rplidar"
